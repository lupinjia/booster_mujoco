<mujoco model="k1 scene">
  <include file="K1_22dof.xml"/>

  <statistic center="0 0 1.1" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/> -->

    <!-- Slope -->
    <body name="up_ramp" pos="4 2.0 0.1" euler="0 0 -1.5708">
        <geom type="box" size="1 1 0.1" pos="0 0 0" euler="0.3 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>
    <body name="platform" pos="5.8 2.0 0.38" euler="0 0 0">
        <geom type="box" size="0.9 1 0.1" pos="0 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>
    <body name="down_ramp" pos="7.6 2.0 0.1" euler="0 0 -1.5708">
        <geom type="box" size="1 1 0.1" pos="0 0 0" euler="-0.3 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>

    <!-- Stairs -->
    <body name="stair1" pos="4 -2.0 0.10" euler="0 0 0">
        <geom type="box" size="1 1 0.1" pos="0 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>
    <body name="stair2" pos="4 -2.0 0.30" euler="0 0 0">
        <geom type="box" size="0.8 0.9 0.1" pos="-0.2 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>
    <body name="stair3" pos="4 -2.0 0.50" euler="0 0 0">
        <geom type="box" size="0.6 0.8 0.1" pos="-0.4 0 0" rgba="0.5 0.5 0.5 1" friction="1 0.1 0.001"/>
    </body>
  </worldbody>
</mujoco>
